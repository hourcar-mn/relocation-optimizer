{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "relocation-optimizer",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-11",
	"observability": {
		"enabled": true
	},
	// built frontend; /api/* goes to the Worker, everything else is served static
	"assets": {
		"directory": "./frontend/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"containers": [
		{
			"class_name": "OptimizerContainer",
			"image": "./Dockerfile",
			"instance_type": "standard-2",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "OPTIMIZER",
				"class_name": "OptimizerContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"OptimizerContainer"
			]
		}
	],
	// cached assignment runs + the data files and caches the container syncs
	"r2_buckets": [
		{
			"binding": "RESULTS",
			"bucket_name": "relocation-optimizer"
		},
		{
			"bucket_name": "relocation-optimizer",
			"binding": "relocation_optimizer"
		}
	]
}