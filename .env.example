VULOG_SERVER=
VULOG_FLEET_ID=
VULOG_API_KEY=

API_USERNAME=
API_PASSWORD=
CLIENT_ID=
CLIENT_SECRET=

# Only needed when running against R2 (the deployed container sets these from
# Worker secrets). Leave blank locally and data_files/ is read straight off disk.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Azure SQL, only used by refresh_data.py (the monthly input refresh).
# Server/name/user have working defaults in the script; the password does not.
DB_PASSWORD=
