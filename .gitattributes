# normalize line endings in the repo, keep native ones in the working tree
* text=auto

# anything a shell executes inside the container image has to be LF,
# no matter who checked it out
*.sh text eol=lf
Dockerfile text eol=lf

# huge single-line files — diffing or merging them is useless and slow.
# csv/pkl are gitignored today, the rules stay so a stray `add -f` can't
# wreck a checkout.
*.geojson -diff -merge
*.csv -diff
*.pkl binary
